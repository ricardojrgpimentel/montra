<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Só para poder distinguir "estás offline" de "o servidor falhou" antes de
         escrever seja o que for no ecrã. Não é usada para nada mais. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Installing APKs is the whole point of the app. The user still gets the
         system installer dialog: nothing here installs silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The download runs in a foreground service so it survives the user leaving
         the app: the catalogue contains APKs over 300 MB. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Só para a verificação periódica do catálogo sobreviver ao reboot
         (`setPersisted`). Sem isto o sistema recusa agendá-la, e a loja só voltaria a
         ver o catálogo quando alguém se lembrasse de abrir a app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- QUERY_ALL_PACKAGES: a store must be able to ask "is this installed, and
         which version?". The catalogue is dynamic, so a <queries> list is not
         possible. This is the same reason F-Droid, Obtainium and App Manager
         declare it. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".MontraApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Montra"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">

        <!-- AppCompat persists the language choice on Android 12 and earlier. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Abrir a ficha de uma app por link: `montra://app/<id>`.
                 Esquema próprio e não um endereço https porque estas fichas não existem
                 em sítio nenhum — a loja é a app. É o que permite mandar uma app a
                 alguém, que é a única maneira de uma loja sem servidor circular. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="montra" android:host="app" />
            </intent-filter>
        </activity>

        <service
            android:name=".install.InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- A verificação periódica do catálogo.
             `exported` é `true` porque é o sistema que se liga a este serviço, e um
             componente não exportado não o deixa fazer — é a mesma declaração que o
             `SystemJobService` do WorkManager usa. Quem restringe quem lá chega é a
             permissão `BIND_JOB_SERVICE`, que só o sistema tem. -->
        <service
            android:name=".work.UpdateCheckJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- O APK verificado vive no cache privado da app. Para o partilhar vai por
             aqui, com permissão de leitura só para quem receber o Intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Result of a PackageInstaller session. Not exported: the system sends
             it explicitly to us. -->
        <receiver
            android:name=".install.InstallResultReceiver"
            android:exported="false" />

    </application>

</manifest>
