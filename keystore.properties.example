# Copy to keystore.properties (ignored by git), or set MONTRA_KEYSTORE_PROPERTIES
# to the absolute path of your private properties file.
# storeFile is relative to this properties file; forward slashes also work on Windows.
storeFile=montra-release.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=montra-release
keyPassword=REPLACE_WITH_KEY_PASSWORD
